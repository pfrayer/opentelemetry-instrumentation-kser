{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "dependencyDashboard": false,
    "extends": [
        "config:recommended",
        "group:all"
    ],
    "minimumReleaseAge": "1 days",
    "packageRules": [
        {
            "ignoreUnstable": false,
            "matchFileNames": [
                "*"
            ]
        }
    ],
    "separateMajorMinor": false,
    "separateMinorPatch": false
}
